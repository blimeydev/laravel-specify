{
    "name": "blimeydev/laravel-specify",
    "description": "A package to automatically create routes and display entries generated by specify",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "BlimeyDev\\LaravelSpecify\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BlimeyDev\\Tests\\": "tests/",
            "App\\": "workbench/app/",
            "Database\\Factories\\": "workbench/database/factories/",
            "Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "authors": [
        {
            "name": "Sean Jewell",
            "email": "sean@isgoms.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "BlimeyDev\\LaravelSpecify\\Providers\\SpecifyPagesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "require-dev": {
        "pestphp/pest": "4.x-dev",
        "orchestra/testbench": "*"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": [
            "@clear",
            "@php vendor/bin/pest"
        ]
    }
}